{% import '@ncids_trans/layout/page_options_macros.twig' as pageOptionsMacros %}

{{ attach_library('ncids_trans/login-page') }}

{{ page.ncids_banner }}
{{ page.ncids_site_alerts }}
{{ page.ncids_header }}

<div class="grid-container">
  <div class="grid-row flex-no-wrap">
    <div class="grid-col-10">
      {{ page.ncids_breadcrumb }}
    </div>
    {# Keep page options in the same positions as other NCIDS pages. #}
    {{ pageOptionsMacros.page_options("top") }}
  </div>
</div>

<div id="page" class="grid-container">
  <div class="grid-row grid-gap">
    <div class="grid-col-12">
      <main id="main-content" class="usa-prose login-page">
        {{ page.content }}
      </main>
    </div>
    <div class="grid-col-12">
      {{ pageOptionsMacros.page_options("bottom") }}
    </div>
  </div>
</div>

{{ page.ncids_footer }}
