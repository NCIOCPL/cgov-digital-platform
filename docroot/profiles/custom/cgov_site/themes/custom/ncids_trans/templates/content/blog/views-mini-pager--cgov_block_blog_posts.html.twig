{#
 # Draw Older/Newer Posts links on Blog Series page.
 # The placement of older->next and newer->previous is correct, as the
 # posts are listed in descending order.
 #}
<div class="cgdp-blog-post-pager">
  {% if(items.next) %}
    <a class="cgdp-blog-post-pager--older usa-link" href="{{ items.next.href }}">&lt; {{ items.next.text }}</a>
  {% endif %}
  {% if(items.previous) %}
    <a class="cgdp-blog-post-pager--newer usa-link" href="{{ items.previous.href }}">{{ items.previous.text }} &gt;</a>
  {% endif %}
</div>
