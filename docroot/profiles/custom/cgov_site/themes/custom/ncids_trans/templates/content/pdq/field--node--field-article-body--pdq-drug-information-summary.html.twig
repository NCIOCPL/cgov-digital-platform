{#
/**
 * @file
 * Theme override for the PDQ Drug Information Summary article body.
 *
 * PDQ DIS pages render body sections without the "On This Page" navigation.
 */
#}
{% set body_attribs = create_attribute({'class': ['cgdp-article-body']}) %}
{% if items | length > 1 %}
  {% set body_attribs = body_attribs.addClass('cgdp-article-body--multiple') %}
{% endif %}

<div {{ body_attribs }}>
  {% for item in items %}
    {{ item.content }}
  {% endfor %}
</div>
