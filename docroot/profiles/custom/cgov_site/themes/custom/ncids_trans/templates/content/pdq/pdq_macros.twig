{#
/**
 * @file
 * Theme macros for PDQ content.
 */
#}

{% macro pronunciation(audio_id, pronunciation_key) -%}
  {%- set audio_id = audio_id|default('')|trim -%}
  {%- set pronunciation_key = pronunciation_key|default('')|trim -%}
  {%- if audio_id or pronunciation_key -%}
    <div class="cgdp-pdq-pronunciation"
      data-pdq-pronunciation
    >
      {% if pronunciation_key %}
        <p>({{ pronunciation_key }})</p>
      {% endif %}
      {% if audio_id %}
        <audio
          preload="none"
          data-pdq-audio
          data-pdq-audio-id="{{ audio_id }}"
        ></audio>
        <button
          type="button"
          class="cgdp-audiofile cgdp-audiofile--large"
          data-pdq-audio-trigger
        >
          <span class="usa-sr-only">{{ 'Listen to pronunciation'|t }}</span>
        </button>
      {% endif %}
    </div>
  {%- endif -%}
{%- endmacro %}
