{% import '@ncids_trans/listing/ncids_list_item_macros.twig' as listItemMacros %}

{% if content.field_external_link[0] %}

  {# ###### Setup Title ####### #}
  {% set title = content.field_override_title|field_value %}

  {# ###### Setup Date ####### #}
  {% set date = null %}
  {% if content.field_display_date[0] %}
    {% set date = content.field_display_date %}
  {% endif %}

  {# ###### Setup Description ####### #}
  {% set description = content.field_override_list_description|field_value %}

  {# ###### Setup the URL ###### #}
  {% set url = content.field_external_link[0]['#url'] %}

  {{ listItemMacros.ncids_list_macro_with_date(title, date, description, url, "Title, Description, and Date", null, null, null, null, null, paragraph.field_external_link_display.value) }}
{% endif %}
