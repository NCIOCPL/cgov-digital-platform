{{ attach_library('ncids_trans/pdq') }}
{% import '@ncids_trans/content_page_macros.twig' as contentPageMacros %}
<!-- ********************************* BEGIN Page Content ********************************** -->

<article>
  <div class="cgdpl resize-content">
    <h1>{{- node.label -}}</h1>
    <div id="cgvBody" class="pdqdruginfosummary">
      {{ content.body }}
    </div>
  </div>

  <footer class="cgdp-article-footer">
    {{ content.field_related_resources }}
    {{ drupal_region('pdq_drug_disclaimer') }}
    {{- contentPageMacros.ncidsDisplayDates(node, content) -}}
    {% if node.field_public_use.value == '1' %}
      <div class="cgdp-article-footer__separator">
        {{ drupal_region('public_use') }}
      </div>
    {% endif %}
  </footer>
</article>
